<?xml version="1.0" encoding="utf-8"?>
<!--
   Applies to Auto Backup on API 26-30 (API 31+ uses data_extraction_rules.xml
   instead). See https://developer.android.com/guide/topics/data/autobackup

   Notebook data is explicitly excluded — see docs/22-decisions.md D13.
   allowBackup stays true for small preferences only. Excluding paths that
   don't exist yet (the Room database, the per-notebook ink files) is
   harmless and is deliberately in place before persistence lands, so
   nobody has to remember to add it later.
-->
<full-backup-content>
    <include domain="sharedpref" path="." />
    <exclude domain="database" path="vahi.db" />
    <exclude domain="file" path="notebooks/" />
</full-backup-content>
